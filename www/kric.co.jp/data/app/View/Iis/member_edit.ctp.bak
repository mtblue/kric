  <script>
  (function () {
    var fileInput   = document.getElementById('photoFileInput');
    var fileName    = document.getElementById('photoFileName');
    var preview     = document.getElementById('photoPreview');
    var previewImg  = document.getElementById('photoPreviewImg');
    var fileInfo    = document.getElementById('photoFileInfo');
    if (fileInput) {
      fileInput.addEventListener('change', function () {
        var file = fileInput.files[0];
        if (file) {
          if (fileName) fileName.textContent = file.name;
          var reader = new FileReader();
          reader.onload = function (e) {
            previewImg.src = e.target.result;
            preview.style.display = '';
          };
          reader.readAsDataURL(file);
          if (fileInfo) fileInfo.style.display = '';
        } else {
          preview.style.display = 'none';
          if (fileInfo) fileInfo.style.display = 'none';
        }
      });
    }
    var deleteBtn  = document.getElementById('photoDeleteBtn');
    var deleteFlag = document.getElementById('photoDeleteFlag');
    if (deleteBtn && deleteFlag) {
      deleteBtn.addEventListener('click', function () {
        deleteFlag.value = '1';
        deleteBtn.closest('.reg-input--photo').querySelector('.reg-member-photo').style.display = 'none';
        deleteBtn.closest('.reg-input--photo').querySelector('.reg-file-current').style.display = 'none';
        deleteBtn.style.display = 'none';
      });
    }
  })();
  </script>
