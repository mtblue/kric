  <script>
  (function () {
    var fileInput = document.getElementById('admMemberPhoto');
    if (!fileInput) return;
    var wrap = document.getElementById('admPhotoPreview');
    var imgWrap = document.getElementById('admPhotoImgWrap');
    var pvImg = document.getElementById('admPhotoPvImg');
    var fileName = document.getElementById('admPhotoFileName');
    var clearBtn = document.getElementById('admPhotoClear');
    function hideExistingPhoto() {
      var cur = document.getElementById('admPhotoCurWrap');
      var tmp = document.getElementById('admPhotoTmpWrap');
      if (cur) cur.style.display = 'none';
      if (tmp) tmp.style.display = 'none';
    }
    function showExistingPhoto() {
      var cur = document.getElementById('admPhotoCurWrap');
      var tmp = document.getElementById('admPhotoTmpWrap');
      if (cur) cur.style.display = '';
      if (tmp) tmp.style.display = '';
    }
    fileInput.addEventListener('change', function () {
      var file = this.files[0];
      if (imgWrap) imgWrap.style.display = 'none';
      if (!file) { if (wrap) wrap.style.display = 'none'; showExistingPhoto(); return; }
      if (wrap) wrap.style.display = '';
      if (fileName) { fileName.textContent = file.name; fileName.style.display = ''; }
      hideExistingPhoto();
      var reader = new FileReader();
      reader.onload = function (e) { pvImg.src = e.target.result; imgWrap.style.display = ''; };
      reader.readAsDataURL(file);
    });
    if (clearBtn) clearBtn.addEventListener('click', function () {
      fileInput.value = '';
      if (wrap) wrap.style.display = 'none';
      if (imgWrap) imgWrap.style.display = 'none';
      showExistingPhoto();
    });
  })();
  </script>
