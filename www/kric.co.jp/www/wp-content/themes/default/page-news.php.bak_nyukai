              <span class="media-acc-arrow">▼</span>
            </button>
          </div>
          <div class="media-acc-item" data-ch="yt">
            <button class="media-acc-header js-media-acc" type="button">
              <span>【YouTube】<br>ナニワの地理学<br>スピンオフ</span>
              <span class="media-acc-arrow">▼</span>
            </button>
