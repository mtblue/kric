      <h1 class="page-kv-title">NEWS</h1>
    </div>
  </section>

  <!-- パンくず -->
  <div class="page-breadcrumb">
    <a href="<?php echo esc_url(home_url('/')); ?>">関西不動産情報センター TOP</a>
    <span class="page-breadcrumb-sep">&gt;</span>
    NEWS
  </div>

  <!-- ========== 新着情報 ========== -->
  <section class="news-sec" id="news">
