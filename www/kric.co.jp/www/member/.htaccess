<IfModule mod_rewrite.c>
    RewriteEngine On

# =============================================================================
# 旧・会員紹介（CakePHP）は 2026-09-10 のリニューアルで /kaiin.html へ移行済み。
# 配下すべてを新ページへ 301 で転送する。
# ※ 親（docroot）の .htaccess のルールはこのディレクトリには継承されないため、
#    リダイレクトはここに書く必要がある。
# =============================================================================
    RewriteRule ^ /kaiin.html [R=301,L]
</IfModule>
