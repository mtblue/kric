<body>

  <!-- ========== HEADER ========== -->
  <header id="header">
    <div class="header-inner">
      <div class="header-logo">
        <a href="index.html" class="logo-text">
          <img src="images/hd_logo.png" alt="KRIC" class="logo-img">
          <span class="logo-ja">関西不動産情報センター</span>
        </a>
      </div>
      <div class="header-right">
        <div class="header-btns">
          <a href="#join" class="btn-hd btn-hd--join"><img src="images/hd_join.png" class="btn-hd-icon" alt=""><span class="btn-text">ご入会はこちら</span><span class="btn-sep">|</span><span class="btn-arrow">▶</span></a>
          <a href="iis/login.html" class="btn-hd btn-hd--member"><img src="images/hd_login.png" class="btn-hd-icon" alt=""><span class="btn-text">会員専用｜ログイン</span><span class="btn-sep">|</span><span class="btn-arrow">▶</span></a>
        </div>
        <button class="menu-btn" id="menuBtn" aria-label="メニューを開く">
          <span class="menu-btn-lines">
            <span></span><span></span><span></span>
          </span>
          <span class="menu-btn-label">MENU</span>
        </button>
      </div>
    </div>
  </header>

  <!-- ========== GLOBAL NAV ========== -->
  <div class="gnav-overlay" id="gnavOverlay"></div>
