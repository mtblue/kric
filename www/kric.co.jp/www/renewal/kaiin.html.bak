  <!-- ========== ページKV ========== -->
  <section class="dandai-kv">
    <div class="dandai-kv-placeholder"></div>
    <div class="dandai-kv-overlay">
      <h1 class="dandai-kv-title">会員紹介</h1>
    </div>
  </section>

  <!-- パンくず -->
  <div class="dandai-breadcrumb">
    <a href="index.html">関西不動産情報センター TOP</a>
    <span class="dandai-breadcrumb-sep">&gt;</span>
    会員紹介
  </div>

  <!-- ========== 概要テキスト ========== -->
  <div class="kaiin-intro">
    <div class="kaiin-intro-inner">
      <p class="kaiin-intro-lead">大阪を中心に関西一円にございます。</p>
      <p class="kaiin-intro-text">関西不動産情報センターは、大阪・兵庫・京都の各部会に属する会員企業で構成されております。信託銀行・都市銀行・大手私鉄・商社・生保・建設会社などの直系不動産会社、そして由緒ある老舗など優良不動産業者を中心に、信用と実績を誇る企業が加盟しております。</p>
    </div>
  </div>

  <!-- ========== マップ検索 ========== -->
  <section class="kaiin-map-sec" id="map">
    <h2 class="dandai-sec-heading" style="max-width:1220px; margin-left:auto; margin-right:auto; padding-left:0; margin-bottom:24px;">マップ検索</h2>
    <div class="kaiin-map-inner">
      <div class="kaiin-map-wrap">
        <div class="kaiin-map-placeholder">地図（Google Maps）</div>
      </div>
    </div>
  </section>

  <!-- ========== フリーワード検索 ========== -->
  <section class="kaiin-search-sec" id="search">
    <p class="kaiin-search-heading">- フリーワード検索 -</p>
    <div class="kaiin-search-form">
      <input type="text" class="kaiin-search-input" placeholder="会社名">
      <input type="text" class="kaiin-search-input" placeholder="エリア・都">
      <button class="kaiin-search-btn">
        <span>検索</span>
        <span class="kaiin-search-icon">🔍</span>
      </button>
    </div>
    <p class="kaiin-search-note">（会員を表示（五十音順））</p>
  </section>

  <!-- ========== 会員リスト ========== -->
  <section class="kaiin-list-sec">
    <div class="kaiin-list-inner">

      <!-- 五十音インデックス -->
      <div class="kaiin-abc">
        <a href="#" class="kaiin-abc-btn is-active">あ <span>▼</span></a>
        <a href="#" class="kaiin-abc-btn">か <span>▼</span></a>
        <a href="#" class="kaiin-abc-btn">き <span>▼</span></a>
        <a href="#" class="kaiin-abc-btn">た <span>▼</span></a>
