        <a href="#" class="kaiin-abc-btn">ま <span>▼</span></a>
        <a href="#" class="kaiin-abc-btn">や <span>▼</span></a>
        <a href="#" class="kaiin-abc-btn">ら <span>▼</span></a>
        <a href="#" class="kaiin-abc-btn">わ <span>▼</span></a>
      </div>

      <!-- 会員一覧 -->
      <div class="kaiin-list-item">
        <a href="#" class="kaiin-company-name">株式会社アイエイホーム</a>
        <p class="kaiin-company-addr">〒530-0047<br>大阪府大阪市北区西天満4-3-11　梅新パークビル</p>
      </div>
      <div class="kaiin-list-item">
        <a href="#" class="kaiin-company-name">株式会社アイエイホーム</a>
        <p class="kaiin-company-addr">〒530-0047<br>大阪府大阪市北区西天満4-3-11　梅新パークビル</p>
      </div>
      <div class="kaiin-list-item">
        <a href="#" class="kaiin-company-name">株式会社アイエイホーム</a>
        <p class="kaiin-company-addr">〒530-0047<br>大阪府大阪市北区西天満4-3-11　梅新パークビル</p>
      </div>
      <div class="kaiin-list-item">
        <a href="#" class="kaiin-company-name">株式会社アイエイホーム</a>
        <p class="kaiin-company-addr">〒530-0047<br>大阪府大阪市北区西天満4-3-11　梅新パークビル</p>
      </div>
      <div class="kaiin-list-item">
        <a href="#" class="kaiin-company-name">株式会社アイエイホーム</a>
        <p class="kaiin-company-addr">〒530-0047<br>大阪府大阪市北区西天満4-3-11　梅新パークビル</p>
      </div>

    </div>
